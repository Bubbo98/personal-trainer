# Copy to backend/.env and fill in. Production values live in Vercel's environment variables.
# Every variable is read in config.js.

# Required
JWT_SECRET=            # node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_USERNAME=        # the admin account's username

# Database: Turso in production. Leave both empty to use a local SQLite file (DB_PATH).
TURSO_DATABASE_URL=    # libsql://<db>.turso.io
TURSO_AUTH_TOKEN=
# DB_PATH=./database/app.db

# Cloudflare R2 (videos, thumbnails, plan PDFs, body composition reports)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Emails (Resend): without the key no email is sent
RESEND_API_KEY=
ADMIN_EMAIL=           # receives "new check" notifications
# FROM_EMAIL=EserciziFacili <noreply@esercizifacili.com>

# Vercel Cron calls /api/cron/* with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Optional
# PORT=3001
# NODE_ENV=development
# PUBLIC_APP_URL=https://www.esercizifacili.com     # login links and emails
# CORS_ORIGINS=http://localhost:3000,https://www.esercizifacili.com
# RETENTION_PROTECTED_USER_IDS=165                  # never deleted by the nightly cleanup
